# ============================================================================
# Tuinwerken Cis — omgevingsvariabelen
# Kopieer dit bestand naar `.env` en vul de waarden in.
# `.env` staat in .gitignore en mag NOOIT gecommit worden.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Lokale dev-database uit docker-compose.yml:
DATABASE_URL="postgresql://tuinwerken:tuinwerken_dev@localhost:5433/tuinwerken"

# --- Sessies & beveiliging ---------------------------------------------------
# Minstens 32 tekens; wordt gebruikt voor de versleutelde sessiecookie
# én (afgeleid) voor de versleuteling van het TOTP-geheim in de database.
# Genereer bv. met:  node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Beheerder (eenmalige seed) ----------------------------------------------
# Bij `npm run db:seed` wordt deze gebruiker aangemaakt als hij nog niet bestaat.
ADMIN_USERNAME="wim"
ADMIN_PASSWORD=""

# --- E-mail (herinneringen naar klanten) — pas nodig vanaf Fase 3 ------------
# Brevo (gratis tier): SMTP-gegevens vind je in Brevo onder "SMTP & API".
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Afzender zoals de klant hem ziet. Het adres moet in Brevo geverifieerd zijn.
MAIL_FROM="Tuinwerken Cis <jouw-geverifieerd-adres@voorbeeld.be>"

# --- Productie (alleen op de Hetzner-server; zie docs/deployment.md) ---------
# Domein waarop de app draait; Caddy haalt er automatisch een HTTPS-certificaat voor.
APP_DOMAIN="app.voorbeeld.be"
# Wachtwoord van de productiedatabase. DATABASE_URL wordt in productie
# automatisch opgebouwd door docker-compose.prod.yml — niet zelf invullen daar.
POSTGRES_PASSWORD=""

# --- EenvoudigFactureren — pas nodig vanaf Fase 1 (import) -------------------
# Auth-modus: "apikey" of "basic". Credentials genereer je in EenvoudigFactureren.
EF_AUTH_MODE="apikey"
EF_API_KEY=""
# Headernaam voor de API-key (wordt in Fase 1 geverifieerd tegen de echte API).
EF_API_KEY_HEADER="X-API-Key"
# Alternatief bij EF_AUTH_MODE="basic":
EF_BASIC_USER=""
EF_BASIC_PASS=""
# Alleen nodig bij meerdere EF-accounts:
EF_ACCOUNT_ID=""
