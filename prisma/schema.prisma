// ============================================================================
// Datamodel Tuinwerken Cis
//
// Afspraken:
// - Alle tijdstippen worden als UTC (timestamptz) opgeslagen. Omrekenen naar
//   Europe/Brussels gebeurt uitsluitend in code (Luxon), nooit in de database.
// - Geldbedragen en uren zijn Decimal — nooit floats (afrondingsfouten).
// - Tarieven worden bij registratie ge-SNAPSHOT in LaborEntry/ExtraCharge,
//   zodat oude registraties/facturen correct blijven als de prijslijst wijzigt.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Authenticatie
// ----------------------------------------------------------------------------

/// ADMIN can do everything, including user management and the audit trail.
/// SUPERUSER can do everything except view the audit trail; user management
/// is deliberately ADMIN-only (see requireAdmin() in src/lib/api.ts).
enum Role {
  ADMIN
  SUPERUSER
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  /// Verplicht, uniek, altijd lowercase opgeslagen. Aanmelden kan met
  /// gebruikersnaam óf e-mail; wachtwoord-reset-mails gaan hiernaartoe.
  email         String    @unique
  passwordHash  String // bcrypt
  /// @default(ADMIN) so the existing (first) user stays admin through this
  /// migration; new users always get an explicit role from the create form.
  role          Role      @default(ADMIN)
  /// TOTP-geheim, AES-256-GCM-versleuteld met een sleutel afgeleid van SESSION_SECRET.
  /// NULL = 2FA nog niet ingesteld → gebruiker wordt bij login naar de setup geleid.
  totpSecret    String?
  totpEnabledAt DateTime?
  createdAt     DateTime  @default(now())

  recoveryCodes       RecoveryCode[]
  trustedDevices      TrustedDevice[]
  passwordResetTokens PasswordResetToken[]
}

/// Eenmalige link "wachtwoord vergeten" (alleen de sha256 van het token wordt
/// bewaard). Bewust niet in de audittrail (zie AUDITED_MODELS).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Eenmalig bruikbare herstelcodes (getoond bij 2FA-setup, alleen gehasht bewaard).
model RecoveryCode {
  id       Int       @id @default(autoincrement())
  userId   Int
  codeHash String // sha256
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// "Vertrouw dit toestel 7 dagen": cookie-token (gehasht) waarmee de
/// TOTP-stap wordt overgeslagen op het eigen toestel.
model TrustedDevice {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique // sha256 van het cookie-token
  label      String? // bv. "iPhone van Wim"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// Klanten
// ----------------------------------------------------------------------------

model Customer {
  id          Int     @id @default(autoincrement())
  name        String
  /// Zonder e-mailadres kan er geen herinnering gestuurd worden; de UI waarschuwt.
  email       String?
  phone       String?
  street      String?
  postalCode  String?
  city        String?
  countryCode String  @default("BE")
  /// Btw-nummer van de klant (EF-veld: tax_code).
  vatNumber   String?
  /// Koppeling met EenvoudigFactureren; gezet bij import of eerste push.
  efClientId  Int?    @unique
  notes       String?
  active      Boolean @default(true)
  /// Demo data (Settings → Algemeen → Demodata): never synced to EF, never e-mailed,
  /// removed with everything attached when demo data is switched off.
  isDemo      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todos              Todo[]
  recurringTemplates RecurringTemplate[]
  invoices           Invoice[]
}

// ----------------------------------------------------------------------------
// Todo's & terugkerend werk
// ----------------------------------------------------------------------------

enum TodoStatus {
  OPEN // nog in te plannen
  PLANNED // heeft een (toekomstige) afspraak
  DONE
  CANCELLED
}

model Todo {
  id                 Int        @id @default(autoincrement())
  /// NULL = "losse todo" (holiday, doctor, ...): planned like any other todo, but
  /// never registered, invoiced or e-mailed.
  customerId         Int?
  title              String
  /// Free note on the todo (shown on the day card and in the editor).
  description        String?
  /// Description for the labour lines on the invoice; empty = "Werkuren op <date>".
  invoiceDescription String?
  estimatedHours     Decimal    @db.Decimal(5, 2)
  status             TodoStatus @default(OPEN)
  /// Free-text name/address for a losse todo (customerId NULL); not a customer
  /// record, so never invoiced/synced. Always NULL when customerId is set.
  contactName        String?
  contactStreet      String?
  contactPostalCode  String?
  contactCity        String?
  /// Project: invoiced directly in EenvoudigFactureren, outside this app.
  /// Hours are registered, but a registration never creates an invoice.
  /// Always false for a losse todo.
  isProject          Boolean    @default(false)
  completedAt        DateTime?

  // --- Koppeling met terugkerend werk -------------------------------------
  /// Gezet wanneer deze todo gegenereerd is uit een RecurringWindow.
  recurringWindowId   Int?
  /// Jaar van de beurt; samen met recurringWindowId de idempotentie-sleutel:
  /// de generatiejob kan nooit twee todo's voor dezelfde beurt aanmaken.
  occurrenceYear      Int?
  /// Concrete voorkeursperiode van deze beurt (bv. 2026-05-01 t/m 2026-05-31).
  windowStart         DateTime? @db.Date
  windowEnd           DateTime? @db.Date
  /// WEEKLY/MONTHLY recurrence: template + occurrence date are the idempotency
  /// key (the job can never generate the same occurrence twice).
  recurringTemplateId Int?
  occurrenceDate      DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer          Customer?          @relation(fields: [customerId], references: [id])
  recurringWindow   RecurringWindow?   @relation(fields: [recurringWindowId], references: [id], onDelete: SetNull)
  recurringTemplate RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  appointments      Appointment[]
  resources         TodoResource[]
  tasks             TodoTask[]
  quoteLines        TodoQuoteLine[]

  @@unique([recurringWindowId, occurrenceYear])
  @@unique([recurringTemplateId, occurrenceDate])
  @@index([customerId])
  @@index([status])
}

/// Sjabloon voor terugkerend werk, bv. "Haag scheren" 2×/jaar.
/// Elke beurt per jaar is een RecurringWindow (2×/jaar = 2 windows).
model RecurringTemplate {
  id             Int     @id @default(autoincrement())
  customerId     Int
  title          String
  description    String?
  /// Copied onto every generated todo (Todo.invoiceDescription); null = "Werkuren op <date>".
  invoiceDescription String?
  /// Project: copied onto every generated todo (Todo.isProject) - invoiced directly
  /// in EenvoudigFactureren, never an invoice from the app.
  isProject          Boolean @default(false)
  estimatedHours Decimal @db.Decimal(5, 2)
  /// Zoveel dagen vóór het begin van het venster verschijnt de todo als "in te plannen".
  leadTimeDays   Int     @default(30)
  active         Boolean @default(true)

  // --- Recurrence pattern (Outlook style); see src/lib/recurrence.ts -------
  /// PERIODS = the yearly windows below (e.g. hedge in May + Sep–Oct);
  /// WEEKLY/MONTHLY = every `interval` weeks/months, one todo per occurrence.
  recurrence       RecurrenceKind @default(PERIODS)
  /// Every N weeks / months (WEEKLY, MONTHLY).
  interval         Int            @default(1)
  /// WEEKLY: ISO weekdays 1 (Mon) .. 7 (Sun).
  weekdays         Int[]          @default([])
  /// MONTHLY: on day `monthDay`, or on the `monthWeek`-th `monthWeekday`.
  monthlyMode      MonthlyMode?
  /// 1..31; clamped to the month's last day (31 → 30 in June).
  monthDay         Int?
  /// 1..4, or 5 = the last one of the month.
  monthWeek        Int?
  monthWeekday     Int?
  /// First possible occurrence (WEEKLY/MONTHLY; anchor of the interval).
  startDate        DateTime?      @db.Date
  /// End: on this date, or after `maxOccurrences` times (both null = never).
  endDate          DateTime?      @db.Date
  maxOccurrences   Int?
  /// Optional season, every year (e.g. 4..10 = April through October; may wrap the year end).
  seasonStartMonth Int?
  seasonEndMonth   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer                    @relation(fields: [customerId], references: [id])
  windows   RecurringWindow[]
  tasks     RecurringTemplateTask[]
  resources RecurringTemplateResource[]
  /// Todos generated by a WEEKLY/MONTHLY pattern (PERIODS link through the window).
  todos     Todo[]

  @@index([customerId])
}

enum RecurrenceKind {
  PERIODS
  WEEKLY
  MONTHLY
}

enum MonthlyMode {
  DAY_OF_MONTH
  NTH_WEEKDAY
}

/// Eén voorkeursperiode binnen een jaar, bv. "Mei" (5/1 – 5/31)
/// of "Sept–Okt" (9/1 – 10/31). endMonth < startMonth = over de jaargrens heen.
model RecurringWindow {
  id         Int    @id @default(autoincrement())
  templateId Int
  label      String // bv. "Mei", "Sept–Okt"
  startMonth Int // 1..12
  startDay   Int    @default(1)
  endMonth   Int // 1..12
  endDay     Int    @default(31)
  sortOrder  Int    @default(0)

  template RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  todos    Todo[]

  @@index([templateId])
}

// ----------------------------------------------------------------------------
// Planning
// ----------------------------------------------------------------------------

enum AppointmentStatus {
  PLANNED
  DONE
  CANCELLED
}

model Appointment {
  id              Int               @id @default(autoincrement())
  todoId          Int
  /// Start van de afspraak, UTC. Dagvergelijkingen altijd via Luxon in Europe/Brussels.
  startAt         DateTime
  durationMinutes Int
  status          AppointmentStatus @default(PLANNED)
  note            String?
  /// Gezet zodra de herinneringsmail succesvol verstuurd is.
  /// Wordt op NULL gereset wanneer de afspraak naar een andere (Brusselse) dag verschuift.
  reminderSentAt  DateTime?
  /// Laatste foutmelding bij het versturen; zichtbaar als badge in de UI.
  reminderError   String?
  /// Confirmed to the customer. Mutually exclusive with `reservation`.
  confirmed       Boolean           @default(false)
  /// Provisional booking that may still change. Mutually exclusive with `confirmed`.
  reservation     Boolean           @default(false)
  /// Actual start on site ("Aangekomen" on the Dagplanning), UTC; chosen by the
  /// user. Default "van" when registering; NULL = not started yet.
  arrivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  todo       Todo        @relation(fields: [todoId], references: [id])
  completion Completion?

  @@index([startAt])
  @@index([todoId])
}

// ----------------------------------------------------------------------------
// Registratie na afronden (uren + extra's)
// ----------------------------------------------------------------------------

/// Eén registratie per afgeronde afspraak: wie heeft hoeveel uren gewerkt
/// en welke extra's (machines, afvoer, ...) worden aangerekend.
model Completion {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique
  completedAt   DateTime @default(now())
  note          String?

  /// Invoice that includes this registration (set when the job is invoiced;
  /// a multi-day job collects several registrations on one invoice).
  invoiceId Int?

  appointment       Appointment   @relation(fields: [appointmentId], references: [id])
  laborEntries      LaborEntry[]
  extraCharges      ExtraCharge[]
  /// The invoice created by (the last registration of) this job.
  invoice           Invoice?      @relation("InvoiceTrigger")
  includedInInvoice Invoice?      @relation("InvoiceCompletions", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

/// Hours of one resource (person or machine) on one registration.
/// registeredHours = actually worked (for reporting); invoicedHours = what is
/// charged (may differ). Both in whole quarters ("per begonnen kwartier").
/// Name, type, hourlyRate and vatRate are snapshots at registration time.
/// workerName NULL + resourceId NULL = legacy "own hours" of the owner.
model LaborEntry {
  id              Int           @id @default(autoincrement())
  completionId    Int
  resourceId      Int?
  resourceType    ResourceType?
  workerName      String?
  registeredHours Decimal       @db.Decimal(5, 2)
  invoicedHours   Decimal       @db.Decimal(5, 2)
  /// Snapshot of the resource's rate (per `rateUnit`) at registration.
  hourlyRate      Decimal       @db.Decimal(8, 2)
  /// DAY = day rate: the invoice charges `invoicedDays` days (invoicedHours
  /// then just follows the worked hours, for reporting).
  rateUnit        RateUnit      @default(HOUR)
  invoicedDays    Decimal?      @db.Decimal(4, 2)
  vatRate         Decimal       @db.Decimal(4, 2)

  completion Completion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  resource   Resource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([completionId])
  @@index([resourceId])
}

enum ResourceType {
  PERSON
  MACHINE
}

/// Resources that are planned and invoiced: people (regular workers) and
/// machines. Configured on the "Resources" page. PERSON resources are also
/// the picklist of the mobile registration flow (formerly the Worker model).
model Resource {
  id         Int          @id @default(autoincrement())
  name       String
  type       ResourceType @default(PERSON)
  /// The rate per `rateUnit` (an hourly rate, or a day rate for most machines).
  hourlyRate Decimal      @db.Decimal(8, 2)
  rateUnit   RateUnit     @default(HOUR)
  active     Boolean      @default(true)
  /// Created by the demo data (machines); removed again when demo data is switched off.
  isDemo     Boolean      @default(false)

  todoResources     TodoResource[]
  templateResources RecurringTemplateResource[]
  laborEntries      LaborEntry[]
}

/// Resource requirement of a todo: which resource is needed and for how many
/// hours. Independent of Todo.estimatedHours (the sum need not match).
model TodoResource {
  id         Int     @id @default(autoincrement())
  todoId     Int
  resourceId Int
  hours      Decimal @db.Decimal(5, 2)

  todo     Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([todoId, resourceId])
  @@index([resourceId])
}

/// Quick picks for the title of a losse todo ("Vakantie", "Doktersafspraak", ...),
/// managed in Settings → Losse todo's.
model LooseTodoPreset {
  id        Int     @id @default(autoincrement())
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

/// Master list of standard tasks ("checklist"), managed in Settings.
/// Picked per todo / recurring work; todos keep a snapshot of the name.
model ChecklistItem {
  id        Int     @id @default(autoincrement())
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  /// Created by the demo data; removed again when demo data is switched off.
  isDemo    Boolean @default(false)

  todoTasks     TodoTask[]
  templateTasks RecurringTemplateTask[]
}

/// One checklist line on a todo. `label` is a snapshot of the checklist item
/// name, so renaming/deleting the master item never changes existing todos.
model TodoTask {
  id              Int     @id @default(autoincrement())
  todoId          Int
  checklistItemId Int?
  label           String
  done            Boolean @default(false)
  /// Not on the planned checklist: added as "extra done" during registration.
  unplanned       Boolean @default(false)
  sortOrder       Int     @default(0)

  todo          Todo           @relation(fields: [todoId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@index([todoId])
  @@index([checklistItemId])
}

/// Checklist items of a recurring work template; copied onto every generated todo.
model RecurringTemplateTask {
  id              Int @id @default(autoincrement())
  templateId      Int
  checklistItemId Int
  sortOrder       Int @default(0)

  template      RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  checklistItem ChecklistItem     @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)

  @@unique([templateId, checklistItemId])
  @@index([checklistItemId])
}

/// Resources of a recurring work template (with hours); copied onto every generated todo.
model RecurringTemplateResource {
  id         Int     @id @default(autoincrement())
  templateId Int
  resourceId Int
  hours      Decimal @db.Decimal(5, 2)

  template RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  resource Resource          @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([templateId, resourceId])
  @@index([resourceId])
}

/// Configureerbare prijslijst: machinegebruik, afvoer groenafval, ...
model PriceListItem {
  id            Int     @id @default(autoincrement())
  name          String
  /// Max 10 tekens — harde limiet van EenvoudigFactureren voor factuureenheden.
  unit          String  @db.VarChar(10)
  unitPrice     Decimal @db.Decimal(10, 2)
  vatRate       Decimal @default(21) @db.Decimal(4, 2)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  /// Link to the EenvoudigFactureren stock item (set by the EF product import).
  efStockItemId Int?    @unique
}

/// Aangerekende extra op een registratie. Alle velden zijn snapshots;
/// priceListItemId is louter een referentie naar de bron.
model ExtraCharge {
  id              Int     @id @default(autoincrement())
  completionId    Int
  priceListItemId Int?
  description     String
  quantity        Decimal @db.Decimal(8, 2)
  unit            String  @db.VarChar(10)
  unitPrice       Decimal @db.Decimal(10, 2)
  vatRate         Decimal @db.Decimal(4, 2)

  completion Completion @relation(fields: [completionId], references: [id], onDelete: Cascade)

  @@index([completionId])
}

// ----------------------------------------------------------------------------
// Facturen (push naar EenvoudigFactureren)
// ----------------------------------------------------------------------------

enum InvoicePushStatus {
  PENDING // lokaal aangemaakt, push nog bezig/niet gestart
  CONCEPT_CREATED // conceptfactuur staat in EenvoudigFactureren
  FAILED // push mislukt; retry mogelijk vanuit de UI
  /// Invoice sync to EF was switched off in Settings when this invoice was made;
  /// can be sent to EF later from the invoices page once sync is on again.
  NOT_SYNCED
}

model Invoice {
  id           Int               @id @default(autoincrement())
  completionId Int               @unique
  customerId   Int
  /// Id van de conceptfactuur in EenvoudigFactureren (gezet bij geslaagde push).
  efInvoiceId  Int?
  pushStatus   InvoicePushStatus @default(PENDING)
  /// Exacte items-payload zoals naar EF gestuurd — audittrail + basis voor retry.
  linesJson    Json
  totalExclVat Decimal           @db.Decimal(10, 2)
  /// Editable structure of the invoice: { lines: [{ item, remark? }], notes: [] }.
  /// linesJson (the EF payload) is generated from it. NULL for invoices made
  /// before v0.24.0 (then derived from linesJson).
  contentJson  Json?
  /// Set when the invoice was edited by hand after the registration.
  editedAt     DateTime?
  /// "Niet versturen": never pushed to EF (single or bulk) until switched off again.
  syncExcluded Boolean           @default(false)
  errorMessage String?
  createdAt    DateTime          @default(now())
  pushedAt     DateTime?

  completion  Completion      @relation("InvoiceTrigger", fields: [completionId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  /// All registrations (days) charged on this invoice.
  completions Completion[]    @relation("InvoiceCompletions")
  /// Quote lines charged on this invoice.
  quoteLines  TodoQuoteLine[]

  @@index([customerId])
  @@index([pushStatus])
}

// ----------------------------------------------------------------------------
// Instellingen & logging
// ----------------------------------------------------------------------------

/// Zakelijke instellingen, bewerkbaar in de UI (eigen uurtarief, btw op arbeid,
/// uur van de herinneringsmail, mailtemplate, ...). Secrets horen hier NIET —
/// die staan in env-variabelen.
model Setting {
  key   String @id
  value Json
}

model EmailLog {
  id            Int      @id @default(autoincrement())
  appointmentId Int?
  toAddress     String
  subject       String
  status        String // SENT | FAILED
  error         String?
  sentAt        DateTime @default(now())

  @@index([appointmentId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Audittrail van alle wijzigingen op de zakelijke tabellen (zie
/// src/lib/db.ts — automatisch gevuld via een Prisma Client Extension,
/// dus geen enkele create/update/delete op een auditbare tabel kan dit
/// overslaan). Authenticatie-tabellen (User, RecoveryCode, TrustedDevice)
/// worden bewust NIET gelogd: `before`/`after` zouden anders wachtwoord-
/// hashes en 2FA-geheimen in de audittrail zetten.
model AuditLog {
  id        Int         @id @default(autoincrement())
  /// Prisma-modelnaam, bv. "Customer", "Invoice".
  tableName String
  /// Primary key van de gewijzigde rij, als string (werkt voor Int- en String-keys).
  recordId  String
  action    AuditAction
  /// Aangemelde gebruiker die de wijziging deed; NULL = door een achtergrondjob
  /// (cron: herinneringen, terugkerend werk) zonder ingelogde gebruiker.
  userId    Int?
  /// Volledige rij vóór de wijziging (NULL bij CREATE).
  before    Json?
  /// Volledige rij na de wijziging (NULL bij DELETE).
  after     Json?
  createdAt DateTime    @default(now())

  @@index([tableName, recordId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Quotes (offertes) from EenvoudigFactureren
// ---------------------------------------------------------------------------

/// Read-only mirror of an EF quote, synced daily and on demand per customer
/// (services/quotes.ts). Linked to a customer through Customer.efClientId.
/// Not audited: it is a copy of EF data, rewritten by every sync.
model EfQuote {
  id           Int      @id @default(autoincrement())
  efQuoteId    Int      @unique
  efClientId   Int
  number       String
  reference    String?
  date         DateTime @db.Date
  /// EF status: open | accepted | expired | rejected.
  status       String
  totalExclVat Decimal  @db.Decimal(10, 2)
  syncedAt     DateTime

  lines EfQuoteLine[]

  @@index([efClientId])
}

/// A priced line of an EF quote (EF text lines are not mirrored).
model EfQuoteLine {
  id          Int     @id @default(autoincrement())
  quoteId     Int
  efItemId    Int     @unique
  sortOrder   Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  /// Max 10 characters (EF limit on invoice lines).
  unit        String
  /// Unit price excl. VAT, after the line discount.
  amount      Decimal @db.Decimal(10, 2)
  taxRate     Decimal @db.Decimal(4, 2)

  quote     EfQuote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  todoLinks TodoQuoteLine[]

  @@index([quoteId])
}

/// Quote line linked to a todo; proposed in the invoice step of the
/// registration. `invoiceId` is set once it is charged, so it is never
/// invoiced twice.
model TodoQuoteLine {
  id          Int  @id @default(autoincrement())
  todoId      Int
  quoteLineId Int
  invoiceId   Int?

  todo      Todo        @relation(fields: [todoId], references: [id], onDelete: Cascade)
  quoteLine EfQuoteLine @relation(fields: [quoteLineId], references: [id])
  invoice   Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([todoId, quoteLineId])
  @@index([quoteLineId])
  @@index([invoiceId])
}

/// Unit of a resource's rate.
enum RateUnit {
  HOUR
  DAY
}
