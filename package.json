{
  "name": "tuinwerken-cis",
  "version": "0.36.0",
  "private": true,
  "description": "Planningsapp voor Tuinwerken Cis: todo's per klant, weekplanning, herinneringsmails, urenregistratie en automatische conceptfacturen in EenvoudigFactureren.",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:admin": "docker compose up -d pgadmin",
    "demo:on": "tsx --env-file=.env scripts/demo-data.ts on",
    "demo:off": "tsx --env-file=.env scripts/demo-data.ts off",
    "demo:status": "tsx --env-file=.env scripts/demo-data.ts status"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.5",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@serwist/next": "^9.5.14",
    "@tanstack/react-query": "^5.107.1",
    "bcryptjs": "^3.0.3",
    "croner": "^11.0.1",
    "dotenv": "^18.0.10",
    "iron-session": "^9.1.0",
    "luxon": "^3.7.2",
    "next": "^15.5.29",
    "nodemailer": "^10.6.0",
    "otplib": "^13.6.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "serwist": "^9.5.14",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vitest": "^5.1.0"
  }
}
